{
  "name": "onmac-agent",
  "version": "0.0.1",
  "description": "A safety layer that lets you hand your Mac to an AI agent. Every action is approved, every change is reversible, and it can run with no internet at all.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.6" },
  "bin": { "onmac": "./dist/src/cli.js" },
  "files": ["dist", "python", "onmac.example.toml"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --test tests/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "compile": "bun build src/cli.ts --compile --outfile dist/onmac"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
